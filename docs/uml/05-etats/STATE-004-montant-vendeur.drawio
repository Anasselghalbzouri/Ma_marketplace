        <object id="f2" label=""><mxCell style="ellipse;html=1;shape=endState;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="645" y="560" width="30" height="30" as="geometry"/></mxCell></object>
        <object id="t0" label="commande livrée et payée&lt;br&gt;/ montant = valeur de la ligne (sans commission)" req="CA-F010-1, RG-005, RG-012" statut="E"><mxCell style="endArrow=open;endSize=10;html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="i" target="S_ret"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell></object>
        <object id="t1" label="after(dateRéception + 7 j)&lt;br&gt;[aucun retour en cours sur la ligne]" req="RG-024, CA-F011-1" statut="E"><mxCell style="endArrow=open;endSize=10;html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="S_ret" target="S_dis"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell></object>
        <object id="t1b" label="retour clôturé&lt;br&gt;sans remboursement [I]" req="RG-024 (cas HYPOTHÈSE)" statut="I"><mxCell style="endArrow=open;endSize=10;html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;fontSize=11;labelBackgroundColor=#ffffff;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="S_ret" target="S_dis"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="10" y="228"/><mxPoint x="10" y="448"/></Array></mxGeometry></mxCell></object>
        <object id="t2" label="retour remboursé&lt;br&gt;/ montant annulé ; frais vendeur imputés si défaut" req="RG-021, RG-025, CA-F011-3" statut="E"><mxCell style="endArrow=open;endSize=10;html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="S_ret" target="S_ded"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="660" y="228"/></Array></mxGeometry></mxCell></object>
        <object id="t3" label="reversement hebdomadaire enregistré&lt;br&gt;/ déductions en attente imputées" req="RG-018, CA-F011-5" statut="E"><mxCell style="endArrow=open;endSize=10;html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="S_dis" target="S_rev"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell></object>
        <object id="t4" label="retour remboursé (avant reversement) [I]" req="RG-021" statut="I"><mxCell style="endArrow=open;endSize=10;html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="S_dis" target="S_ded"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell></object>
        <object id="t5" label="" statut="E"><mxCell style="endArrow=open;endSize=10;html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="S_rev" target="f1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell></object>
        <object id="t6" label="" statut="E"><mxCell style="endArrow=open;endSize=10;html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="S_ded" target="f2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell></object>
        <object id="n1" label="&lt;b&gt;Reversé puis remboursé&lt;/b&gt; (RG-021, CA-F011-4) : le montant reste « Reversé » ; une &lt;b&gt;Déduction&lt;/b&gt; (CLASS-02) est créée et régularisée sur le reversement suivant."><mxCell style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;" vertex="1" parent="1"><mxGeometry x="340" y="620" width="300" height="80" as="geometry"/></mxCell></object>
        <object id="n1_a0" label=""><mxCell style="endArrow=none;dashed=1;html=1;strokeColor=#999999;rounded=0;" edge="1" parent="1" source="n1" target="S_rev"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell></object>
        <object id="n2" label="&lt;b&gt;WARN&lt;/b&gt; : t1b (retour clôturé sans remboursement, ex. litige gagné par le vendeur) et t4 sont des inférences ; solde négatif (Q38) ; jour du reversement MANQUANT." statut="WARN"><mxCell style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#f8cecc;strokeColor=#b85450;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;" vertex="1" parent="1"><mxGeometry x="820" y="420" width="300" height="90" as="geometry"/></mxCell></object>
        <object id="legend" label="&lt;b&gt;Légende&lt;/b&gt;&lt;br&gt;Rectangle arrondi vert = état (vocabulaire §7) ; ● état initial ; ◉ état final&lt;br&gt;Transition : événement [garde] / action ; after(x) = événement temporel paramétré (durée non fixée)&lt;br&gt;[I] = transition / état HYPOTHÈSE du CDC ou inférence Blueprint ; note rouge = WARN"><mxCell style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=10;fillColor=#f5f5f5;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="820" y="640" width="520" height="65" as="geometry"/></mxCell></object>
