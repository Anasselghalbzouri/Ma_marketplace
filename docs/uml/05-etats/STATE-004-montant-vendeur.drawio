<mxfile host="Blueprint" type="device">
  <diagram id="STATE-004" name="STATE-004 MontantVendeur">
    <mxGraphModel dx="1400" dy="880" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="880" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <object id="title" label="&lt;b&gt;STATE-004 — Machine à états : MontantVendeur (somme due pour une ligne de commande)&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;Source : CDC v1.1 §7 cycle « Montant vendeur » (CONFIRMÉ D29, D34), F011, RG-012, RG-018, RG-021, RG-024, RG-025, CA-F011-1..5&lt;/font&gt;"><mxCell style="text;html=1;fontSize=16;fontStyle=1;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1100" height="50" as="geometry"/></mxCell></object>
        <object id="i" label=""><mxCell style="ellipse;html=1;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="165" y="110" width="30" height="30" as="geometry"/></mxCell></object>
        <object id="S_ret" label="&lt;b&gt;Retenu&lt;/b&gt;" req="§7, RG-024, CA-F010-1" statut="E"><mxCell style="rounded=1;whiteSpace=wrap;html=1;arcSize=40;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="80" y="200" width="200" height="56" as="geometry"/></mxCell></object>
        <object id="S_dis" label="&lt;b&gt;Disponible&lt;/b&gt;" req="§7, RG-024, CA-F011-1" statut="E"><mxCell style="rounded=1;whiteSpace=wrap;html=1;arcSize=40;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="80" y="420" width="200" height="56" as="geometry"/></mxCell></object>
        <object id="S_rev" label="&lt;b&gt;Reversé&lt;/b&gt;" req="§7, RG-018, CA-F011-2" statut="E"><mxCell style="rounded=1;whiteSpace=wrap;html=1;arcSize=40;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="80" y="640" width="200" height="56" as="geometry"/></mxCell></object>
        <object id="S_ded" label="&lt;b&gt;Déduit&lt;/b&gt;" req="§7, RG-021, CA-F011-3" statut="E"><mxCell style="rounded=1;whiteSpace=wrap;html=1;arcSize=40;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="560" y="420" width="200" height="56" as="geometry"/></mxCell></object>
