<mxfile host="Blueprint" type="device">
  <diagram id="STATE-001" name="STATE-001 Commande">
    <mxGraphModel dx="1400" dy="1085" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="1085" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <object id="title" label="&lt;b&gt;STATE-001 — Machine à états : Commande (client)&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;Source : CDC v1.1 §7 cycle « Commande », RG-008, RG-010, RG-011b, RG-013, RG-029, CA-F008-1/2, CA-F009-3, CA-F010-1/3/4 · D22, D44&lt;/font&gt;"><mxCell style="text;html=1;fontSize=16;fontStyle=1;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1100" height="50" as="geometry"/></mxCell></object>
        <object id="i" label=""><mxCell style="ellipse;html=1;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="115" y="110" width="30" height="30" as="geometry"/></mxCell></object>
        <object id="S_att" label="&lt;b&gt;En attente d'acceptation&lt;br&gt;des vendeurs&lt;/b&gt;" req="§7, F007" statut="E"><mxCell style="rounded=1;whiteSpace=wrap;html=1;arcSize=40;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="190" width="200" height="56" as="geometry"/></mxCell></object>
        <object id="S_conf" label="&lt;b&gt;Confirmée&lt;/b&gt; &lt;i&gt;[I]&lt;/i&gt;" req="§7" statut="I"><mxCell style="rounded=1;whiteSpace=wrap;html=1;arcSize=40;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;dashed=1;dashPattern=6 3;" vertex="1" parent="1"><mxGeometry x="40" y="360" width="200" height="56" as="geometry"/></mxCell></object>
        <object id="S_coll" label="&lt;b&gt;En collecte&lt;/b&gt;" req="§7, D44, RG-029" statut="E"><mxCell style="rounded=1;whiteSpace=wrap;html=1;arcSize=40;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="530" width="200" height="56" as="geometry"/></mxCell></object>
        <object id="S_livr" label="&lt;b&gt;En livraison&lt;/b&gt;" req="§7, F010" statut="E"><mxCell style="rounded=1;whiteSpace=wrap;html=1;arcSize=40;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="700" width="200" height="56" as="geometry"/></mxCell></object>
        <object id="S_ok" label="&lt;b&gt;Livrée et payée&lt;/b&gt;" req="§7, CA-F010-1" statut="E"><mxCell style="rounded=1;whiteSpace=wrap;html=1;arcSize=40;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="40" y="870" width="200" height="56" as="geometry"/></mxCell></object>
        <object id="S_ann" label="&lt;b&gt;Annulée&lt;/b&gt;" req="§7, RG-008, RG-010" statut="E"><mxCell style="rounded=1;whiteSpace=wrap;html=1;arcSize=40;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="560" y="360" width="200" height="56" as="geometry"/></mxCell></object>
        <object id="S_ech" label="&lt;b&gt;Échec de livraison&lt;/b&gt;" req="§7, RG-013, CA-F010-3" statut="E"><mxCell style="rounded=1;whiteSpace=wrap;html=1;arcSize=40;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1"><mxGeometry x="560" y="870" width="200" height="56" as="geometry"/></mxCell></object>
        <object id="f1" label=""><mxCell style="ellipse;html=1;shape=endState;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="125" y="990" width="30" height="30" as="geometry"/></mxCell></object>
        <object id="f2" label=""><mxCell style="ellipse;html=1;shape=endState;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="645" y="470" width="30" height="30" as="geometry"/></mxCell></object>
        <object id="f3" label=""><mxCell style="ellipse;html=1;shape=endState;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="645" y="990" width="30" height="30" as="geometry"/></mxCell></object>
        <object id="t0" label="validation de la commande&lt;br&gt;/ créer sous-commandes ; réserver stock ; notifier" req="CA-F007-1, RG-003, RG-017" statut="E"><mxCell style="endArrow=open;endSize=10;html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="i" target="S_att"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell></object>
        <object id="t1" label="toutes les sous-commandes acceptées&lt;br&gt;/ notifier le client" req="F009, P2.7" statut="I"><mxCell style="endArrow=open;endSize=10;html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="S_att" target="S_conf"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell></object>
        <object id="t2" label="refus d'un vendeur, ou after(délaiRéponseVendeur) [I],&lt;br&gt;ou annulation client&lt;br&gt;/ annuler les sous-commandes ; restituer stock ; notifier" req="RG-008, RG-011b, RG-010, CA-F009-3, CA-F014-2" statut="E"><mxCell style="endArrow=open;endSize=10;html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.2;entryDx=0;entryDy=0;" edge="1" parent="1" source="S_att" target="S_ann"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="400" y="218"/><mxPoint x="400" y="371"/></Array></mxGeometry></mxCell></object>
        <object id="t3" label="transmission à la société de livraison&lt;br&gt;(saisie admin) [toutes prêtes]" req="D44, RG-029, CA-F010-4" statut="E"><mxCell style="endArrow=open;endSize=10;html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="S_conf" target="S_coll"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell></object>
        <object id="t4" label="annulation client [aucune sous-commande collectée]&lt;br&gt;/ restituer stock ; notifier vendeurs" req="RG-010, CA-F008-1" statut="I"><mxCell style="endArrow=open;endSize=10;html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.8;entryDx=0;entryDy=0;" edge="1" parent="1" source="S_conf" target="S_ann"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell></object>
        <object id="t5" label="saisie « en livraison » (admin)&lt;br&gt;[toutes sous-commandes collectées]" req="RG-008, RG-029" statut="E"><mxCell style="endArrow=open;endSize=10;html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="S_coll" target="S_livr"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell></object>
        <object id="t6" label="saisie livrée et payée (montant, date)&lt;br&gt;/ montants vendeurs « Retenu » ; écart signalé si ≠ dû" req="CA-F010-1, CA-F010-2" statut="E"><mxCell style="endArrow=open;endSize=10;html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="S_livr" target="S_ok"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell></object>
        <object id="t7" label="saisie échec (motif) / aucun montant dû ;&lt;br&gt;stock restitué [I]" req="RG-013, CA-F010-3" statut="E"><mxCell style="endArrow=open;endSize=10;html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;fontSize=11;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.3;entryDx=0;entryDy=0;" edge="1" parent="1" source="S_livr" target="S_ech"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="470" y="728"/><mxPoint x="470" y="887"/></Array></mxGeometry></mxCell></object>
        <object id="t8" label="" statut="E"><mxCell style="endArrow=open;endSize=10;html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="S_ok" target="f1"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell></object>
        <object id="t9" label="" statut="E"><mxCell style="endArrow=open;endSize=10;html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="S_ann" target="f2"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell></object>
        <object id="t10" label="" statut="E"><mxCell style="endArrow=open;endSize=10;html=1;rounded=1;edgeStyle=orthogonalEdgeStyle;fontSize=11;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="S_ech" target="f3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell></object>
        <object id="n1" label="&lt;b&gt;Annulation client&lt;/b&gt; refusée dès « En collecte » (CA-F008-2, CA-F010-4) : aucune transition client depuis En collecte / En livraison."><mxCell style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;" vertex="1" parent="1"><mxGeometry x="820" y="520" width="280" height="70" as="geometry"/></mxCell></object>
        <object id="n2" label="&lt;b&gt;« Livrée et payée »&lt;/b&gt; = commande close (CA-F010-1). Les retours sont des objets Retour distincts (STATE-003), sans nouvel état de la commande (décision Stage A §7.2)."><mxCell style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;" vertex="1" parent="1"><mxGeometry x="820" y="840" width="280" height="80" as="geometry"/></mxCell></object>
        <object id="n3" label="&lt;b&gt;WARN&lt;/b&gt; Q24 : après « Échec de livraison », nouvelle tentative ou retour des produits aux vendeurs non définis ⇒ état final provisoire. Étapes hors « En collecte » = HYPOTHÈSE §7. Délai de réponse vendeur Q19." statut="WARN"><mxCell style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#f8cecc;strokeColor=#b85450;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;" vertex="1" parent="1"><mxGeometry x="820" y="670" width="280" height="100" as="geometry"/></mxCell></object>
        <object id="legend" label="&lt;b&gt;Légende&lt;/b&gt;&lt;br&gt;Rectangle arrondi vert = état (vocabulaire §7) ; ● état initial ; ◉ état final&lt;br&gt;Transition : événement [garde] / action ; after(x) = événement temporel paramétré (durée non fixée)&lt;br&gt;[I] = transition / état HYPOTHÈSE du CDC ou inférence Blueprint ; note rouge = WARN"><mxCell style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=10;fillColor=#f5f5f5;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="820" y="960" width="520" height="65" as="geometry"/></mxCell></object>
