        <object id="n_ret" label="&lt;b&gt;{RG-019}&lt;/b&gt; Retour possible seulement si dateDemande ≤ Commande.dateRéception + 7 j et produit non exclu.&lt;br&gt;&lt;b&gt;{RG-027 [I]}&lt;/b&gt; décision du Litige finale.&lt;br&gt;&lt;b&gt;{RG-017, D43}&lt;/b&gt; stock restitué seulement si Vérification.remiseEnVente."><mxCell style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="540" width="340" height="110" as="geometry"/></mxCell></object>
        <object id="n_ret_a0" label=""><mxCell style="endArrow=none;dashed=1;html=1;strokeColor=#999999;rounded=0;" edge="1" parent="1" source="n_ret" target="ENT-011"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell></object>
        <object id="n_mv" label="&lt;b&gt;{RG-024}&lt;/b&gt; Retenu jusqu'à dateRéception + 7 j ; reste Retenu si un Retour est en cours sur la ligne [I].&lt;br&gt;&lt;b&gt;{RG-018, CA-F011-5}&lt;/b&gt; Reversement.montant = Σ Disponibles − Σ Déductions non encore imputées."><mxCell style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1180" y="195" width="330" height="100" as="geometry"/></mxCell></object>
        <object id="n_mv_a0" label=""><mxCell style="endArrow=none;dashed=1;html=1;strokeColor=#999999;rounded=0;" edge="1" parent="1" source="n_mv" target="ENT-016"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell></object>
        <object id="n_rem" label="&lt;b&gt;{RG-022, D42}&lt;/b&gt; Remboursement.montant = prix du produit retourné − frais de retour si motif = ChangementDAvis ; jamais en espèces non traçables. Délai légal 15 j (R1, à confirmer) ; frais de livraison initiaux remboursés ? [U Q40]" statut="WARN"><mxCell style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#f8cecc;strokeColor=#b85450;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1560" y="800" width="300" height="120" as="geometry"/></mxCell></object>
        <object id="n_rem_a0" label=""><mxCell style="endArrow=none;dashed=1;html=1;strokeColor=#999999;rounded=0;" edge="1" parent="1" source="n_rem" target="ENT-014"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell></object>
        <object id="n_warn2" label="&lt;b&gt;WARN&lt;/b&gt; : multiplicité LigneCommande–Retour 0..* [I] (retours partiels successifs ?) ; solde vendeur négatif : report signalé [I] (Q38) ; Écart et RemiseDeFonds = HYPOTHÈSE (RG-020)." statut="WARN"><mxCell style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#f8cecc;strokeColor=#b85450;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1560" y="940" width="300" height="100" as="geometry"/></mxCell></object>
        <object id="legend" label="&lt;b&gt;Légende&lt;/b&gt;&lt;br&gt;Classe bleue = entité CONFIRMÉE ; bordure pointillée + [I] = HYPOTHÈSE / inférence&lt;br&gt;Classe grise «réf.» = définie dans l'autre diagramme de classes ; «externe» = hors Plateforme&lt;br&gt;Seuls les attributs cités par le CDC sont portés ; aucune opération (décision Stage A §5)&lt;br&gt;[0..1] = optionnel ; / = dérivé ; [U Qxx] = valeur MANQUANTE ; note rouge = WARN&lt;br&gt;Lien pointillé + [I] = association inférée ; losange plein = composition"><mxCell style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=10;fillColor=#f5f5f5;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="40" y="1320" width="520" height="95" as="geometry"/></mxCell></object>
      </root>
