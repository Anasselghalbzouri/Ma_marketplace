        <object id="n_rg006" label="&lt;b&gt;{RG-006 [I]}&lt;/b&gt; Produit visible et commandable ⇔ publié ∧ ¬masqué ∧ stock &gt; 0 ∧ vendeur actif.&lt;br&gt;&lt;b&gt;{RG-019, D40}&lt;/b&gt; exclu du retour ⇔ périssable ∨ personnalisé ∨ catégorie.exclueDuRetour."><mxCell style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;" vertex="1" parent="1"><mxGeometry x="800" y="90" width="400" height="80" as="geometry"/></mxCell></object>
        <object id="n_rg006_a0" label=""><mxCell style="endArrow=none;dashed=1;html=1;strokeColor=#999999;rounded=0;" edge="1" parent="1" source="n_rg006" target="ENT-004"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell></object>
        <object id="n_rg011" label="&lt;b&gt;{RG-011, D37}&lt;/b&gt; un Avis n'existe que si la Commande de la LigneCommande est « LivréeEtPayée » ; un avis par produit et par commande [I] (2ᵉ avis = modification). Avis masqué ⇒ /noteMoyenne recalculée (CA-F013-3)."><mxCell style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="1110" width="340" height="90" as="geometry"/></mxCell></object>
        <object id="n_rg011_a0" label=""><mxCell style="endArrow=none;dashed=1;html=1;strokeColor=#999999;rounded=0;" edge="1" parent="1" source="n_rg011" target="ENT-020"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell></object>
        <object id="n_rg008" label="&lt;b&gt;{RG-008, D22}&lt;/b&gt; pas de livraison partielle : Commande livrée seulement si toutes ses SousCommandes sont acceptées et collectées ; un refus ⇒ Commande et toutes SousCommandes Annulées.&lt;br&gt;&lt;b&gt;{RG-017 [I]}&lt;/b&gt; stock réservé à la validation, restitué si annulation / refus / échec."><mxCell style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;" vertex="1" parent="1"><mxGeometry x="800" y="1110" width="420" height="104" as="geometry"/></mxCell></object>
        <object id="n_rg008_a0" label=""><mxCell style="endArrow=none;dashed=1;html=1;strokeColor=#999999;rounded=0;" edge="1" parent="1" source="n_rg008" target="ENT-008"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell></object>
        <object id="n_warn" label="&lt;b&gt;WARN&lt;/b&gt; : un Visiteur sans compte peut tenir un panier (HYPOTHÈSE §5) ; rattachement Panier ↔ Client après connexion (CA-F001-3). Données vendeur exigées : MANQUANT (Q22). Une boutique par vendeur : inféré (F002)." statut="WARN"><mxCell style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#f8cecc;strokeColor=#b85450;align=left;verticalAlign=top;spacingLeft=6;spacingTop=2;fontSize=11;" vertex="1" parent="1"><mxGeometry x="1280" y="1110" width="360" height="90" as="geometry"/></mxCell></object>
        <object id="legend" label="&lt;b&gt;Légende&lt;/b&gt;&lt;br&gt;Classe bleue = entité CONFIRMÉE ; bordure pointillée + [I] = HYPOTHÈSE / inférence&lt;br&gt;Classe grise «réf.» = définie dans l'autre diagramme de classes ; «externe» = hors Plateforme&lt;br&gt;Seuls les attributs cités par le CDC sont portés ; aucune opération (décision Stage A §5)&lt;br&gt;[0..1] = optionnel ; / = dérivé ; [U Qxx] = valeur MANQUANTE ; note rouge = WARN&lt;br&gt;Lien pointillé + [I] = association inférée ; losange plein = composition"><mxCell style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=6;fontSize=10;fillColor=#f5f5f5;strokeColor=#999999;" vertex="1" parent="1"><mxGeometry x="1280" y="1220" width="520" height="95" as="geometry"/></mxCell></object>
