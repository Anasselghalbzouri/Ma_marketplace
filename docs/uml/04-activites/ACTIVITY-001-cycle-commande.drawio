        <object id="c1" label="Constituer le panier&lt;br&gt;(un ou plusieurs vendeurs)" req="F006" statut="E"><mxCell style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="lC"><mxGeometry x="35.0" y="139.0" width="210" height="60" as="geometry"/></mxCell></object>
        <object id="c2" label="Se connecter ou créer un compte&lt;br&gt;(obligatoire, RG-028)" req="RG-028, D41, CA-F001-3" statut="E"><mxCell style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="lC"><mxGeometry x="35.0" y="225.0" width="210" height="60" as="geometry"/></mxCell></object>
        <object id="c3" label="Saisir adresse à Tanger et téléphone ;&lt;br&gt;confirmer (paiement à la livraison)" req="F007, RG-002, RG-014, CA-F007-3/4" statut="E"><mxCell style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="lC"><mxGeometry x="35.0" y="311.0" width="210" height="60" as="geometry"/></mxCell></object>
        <object id="p1" label="" req="RG-001, F007"><mxCell style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="lP"><mxGeometry x="128.0" y="405.0" width="44" height="44" as="geometry"/></mxCell></object>
        <object id="pff" label="" req="CA-F007-2 (hors Tanger ou stock insuffisant)"><mxCell style="shape=sumEllipse;perimeter=ellipsePerimeter;whiteSpace=wrap;html=1;backgroundOutline=1;fillColor=#ffffff;" vertex="1" parent="lP"><mxGeometry x="257.0" y="414.0" width="26" height="26" as="geometry"/></mxCell></object>
        <object id="p2" label="Créer la commande et une sous-commande&lt;br&gt;par vendeur ; réserver le stock ;&lt;br&gt;confirmation écrite ; notifier" req="RG-003, RG-017, RG-026, CA-F007-1, CA-F014-1" statut="E"><mxCell style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="lP"><mxGeometry x="45.0" y="480.0" width="210" height="66" as="geometry"/></mxCell></object>
        <object id="v1" label="Accepter ou refuser sa sous-commande&lt;br&gt;(chaque vendeur, délai Q19)" req="F009, RG-011b" statut="E"><mxCell style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="lV"><mxGeometry x="35.0" y="569.0" width="210" height="60" as="geometry"/></mxCell></object>
        <object id="p3" label="" req="RG-008, D22"><mxCell style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;" vertex="1" parent="lP"><mxGeometry x="128.0" y="663.0" width="44" height="44" as="geometry"/></mxCell></object>
        <object id="p4" label="Annuler la commande entière ;&lt;br&gt;restituer le stock ; notifier tous" req="RG-008, CA-F009-3, CA-F014-2" statut="E"><mxCell style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="lP"><mxGeometry x="45.0" y="741.0" width="210" height="60" as="geometry"/></mxCell></object>
