        <object id="v2" label="Préparer et déclarer&lt;br&gt;« prête pour collecte »" req="CA-F009-2" statut="E"><mxCell style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="lV"><mxGeometry x="35.0" y="741.0" width="210" height="60" as="geometry"/></mxCell></object>
        <object id="a1" label="Transmettre la commande à la société&lt;br&gt;de livraison → « En collecte »" req="D44, RG-029, CA-F010-4" statut="E"><mxCell style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="lA"><mxGeometry x="45.0" y="827.0" width="210" height="60" as="geometry"/></mxCell></object>
        <object id="s1" label="Collecter chez chaque vendeur ;&lt;br&gt;livrer en une fois ; encaisser" req="D19, RG-008, RG-002" statut="E"><mxCell style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="lS"><mxGeometry x="35.0" y="913.0" width="210" height="60" as="geometry"/></mxCell></object>
        <object id="a2" label="Saisir collecte, « en livraison »&lt;br&gt;et résultat transmis (RG-029)" req="RG-029, US-008" statut="E"><mxCell style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="lA"><mxGeometry x="45.0" y="999.0" width="210" height="60" as="geometry"/></mxCell></object>
