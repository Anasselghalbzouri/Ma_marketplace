        <object id="title" label="&lt;b&gt;ACTIVITY-001 — Cycle de commande de bout en bout (panier → livraison et paiement)&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;Source : CDC v1.1 P2, P4, P5, F006-F010, F014 · RG-001/003/008/011b/013/017/024/026/028/029 · D22, D38, D41, D44&lt;/font&gt;"><mxCell style="text;html=1;fontSize=16;fontStyle=1;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1100" height="50" as="geometry"/></mxCell></object>
        <object id="lC" label="Client"><mxCell style="swimlane;startSize=30;html=1;whiteSpace=wrap;collapsible=0;fillColor=#f5f5f5;swimlaneFillColor=#ffffff;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="20" y="90" width="280" height="1416" as="geometry"/></mxCell></object>
