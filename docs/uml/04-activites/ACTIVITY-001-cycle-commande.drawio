        <object id="p5" label="« Échec de livraison » ; aucun montant&lt;br&gt;dû ; stock restitué [RG-013] &lt;i&gt;[I]&lt;/i&gt;" req="RG-013, RG-017, CA-F010-3" statut="I"><mxCell style="rounded=1;whiteSpace=wrap;html=1;arcSize=30;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;dashed=1;dashPattern=6 3;" vertex="1" parent="lP"><mxGeometry x="45.0" y="1085.0" width="210" height="60" as="geometry"/></mxCell></object>
