        <object id="lA" label="Administrateur"><mxCell style="swimlane;startSize=30;html=1;whiteSpace=wrap;collapsible=0;fillColor=#f5f5f5;swimlaneFillColor=#ffffff;fontStyle=1;fontSize=12;" vertex="1" parent="1"><mxGeometry x="880" y="90" width="300" height="1416" as="geometry"/></mxCell></object>
        <object id="lS" label="Société de livraison «externe»"><mxCell style="swimlane;startSize=30;html=1;whiteSpace=wrap;collapsible=0;fillColor=#f5f5f5;swimlaneFillColor=#ffffff;fontStyle=1;fontSize=12;fillColor=#e0e0e0;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="1180" y="90" width="280" height="1416" as="geometry"/></mxCell></object>
