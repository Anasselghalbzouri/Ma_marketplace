        <object id="title" label="&lt;b&gt;SEQ-001 — Passage d'une commande multi-vendeurs, acceptation, refus ⇒ annulation totale&lt;/b&gt;&lt;br&gt;&lt;font style='font-size:11px'&gt;Source : CDC v1.1 P2, P4, F006, F007, F009, F014 · RG-001/003/008/011b/017/026/028 · CA-F007-1/2, CA-F009-3, CA-F014-1/2 · D22, D41&lt;/font&gt;"><mxCell style="text;html=1;fontSize=16;fontStyle=1;align=left;verticalAlign=top;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="20" y="10" width="1100" height="50" as="geometry"/></mxCell></object>
