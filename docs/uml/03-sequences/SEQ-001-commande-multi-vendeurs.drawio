        <object id="m03" label="contrôler adresse à Tanger (RG-001)&lt;br&gt;et stock disponible (F007)" req="RG-001"><mxCell style="html=1;verticalAlign=bottom;endArrow=block;endFill=1;rounded=0;fontSize=11;exitX=0.5;exitY=0.1373;entryX=0.5;entryY=0.1582;align=left;spacingLeft=6;verticalAlign=middle;" edge="1" parent="1" source="pf" target="pf"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="440" y="284"/><mxPoint x="440" y="312"/></Array></mxGeometry></mxCell></object>
